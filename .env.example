# ---- required ----
APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string      # signs sessions, encrypts mailbox credentials
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5           # drafting, reply triage, the question box (low volume)
PARSE_MODEL=claude-haiku-4-5         # reading rate cons: ~1/5 of a cent each as text
SCAN_MODE=strict                     # strict: only subjects that look like a rate con / tender reach the reader. thorough: wider, costs more
SCAN_REQUIRE_PDF=0                   # 1: a rate con subject is not enough, the message must carry a PDF. Skips body-only confirmations
BATCH_HISTORY=1                      # history scans are read in half-price batches (results within the hour, up to a day). 0 reads live

# ---- database ----
# Leave DATABASE_URL empty on your laptop: the app runs on an embedded database under .data/
# In production paste a Postgres connection string, e.g. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# ---- billing (Stripe) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CARRIER=price_...        # $99/mo subscription, 200 tokens included
STRIPE_PRICE_FLEET=price_...          # $299/mo subscription, 600 tokens included
STRIPE_PRICE_ENTERPRISE=            # $799/mo subscription, 2,000 tokens included; blank shows "Talk to us"

# ---- contact enrichment: any subset. Waterfall order is fixed in src/lib/enrich/index.ts ----
FINDYMAIL_API_KEY=
PEOPLEDATALABS_API_KEY=
LEADMAGIC_API_KEY=
PROSPEO_API_KEY=
WIZA_API_KEY=

# ---- Microsoft (Outlook) OAuth; leave empty to hide the Outlook button ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- forwarding address: inbound mail webhook (Postmark JSON). Shared secret in the URL path ----
INBOUND_SECRET=change-me
INBOUND_DOMAIN=in.directshipper.co

# ---- cron protection (Vercel sends this header) ----
CRON_SECRET=change-me

# ---- LinkedIn automation (Unipile) ----
# Sign up at unipile.com, create an API key, and copy your DSN (looks like https://api1.unipile.com:13111).
# UNIPILE_WEBHOOK_SECRET is any long random string; it protects the two webhook URLs Unipile calls back.
# Leave blank and LinkedIn steps stay copy-and-paste.
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
